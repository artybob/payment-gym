services:
  nginx:
    image: nginx:alpine
    container_name: laravel12-nginx
    ports:
      - "8080:80"
    volumes:
      - .:/var/www/html
      - ./nginx.conf:/etc/nginx/conf.d/default.conf
    depends_on:
      - app
    networks:
      - laravel-network

  app:
    build:
      context: .
      dockerfile: Dockerfile
    container_name: laravel12-app
    environment:
      - APP_ENV=local
      - APP_DEBUG=true
      - APP_URL=http://localhost:8080
      - DB_CONNECTION=pgsql
      - DB_HOST=postgres
      - DB_PORT=5432
      - DB_DATABASE=payment_gym
      - DB_USERNAME=payment_user
      - DB_PASSWORD=secret
      - QUEUE_CONNECTION=rabbitmq
      - RABBITMQ_HOST=rabbitmq
      - RABBITMQ_PORT=5672
      - RABBITMQ_VHOST=/
      - RABBITMQ_LOGIN=guest
      - RABBITMQ_PASSWORD=guest
    volumes:
      - .:/var/www/html
    depends_on:
      - postgres
      - rabbitmq
    networks:
      - laravel-network

  postgres:
    image: postgres:16
    container_name: laravel12-postgres
    environment:
      POSTGRES_DB: payment_gym
      POSTGRES_USER: payment_user
      POSTGRES_PASSWORD: secret
    ports:
      - "5433:5432"
    volumes:
      - pgdata:/var/lib/postgresql/data
    networks:
      - laravel-network

  rabbitmq:
    image: rabbitmq:3-management
    container_name: laravel12-rabbitmq
    ports:
      - "5673:5672"
      - "15673:15672"
    environment:
      RABBITMQ_DEFAULT_USER: guest
      RABBITMQ_DEFAULT_PASS: guest
    volumes:
      - rabbitmq_data:/var/lib/rabbitmq
    networks:
      - laravel-network

  worker:
    build:
      context: .
      dockerfile: Dockerfile
    container_name: laravel12-worker
    command: php artisan queue:work rabbitmq --sleep=3 --tries=3
    environment:
      - QUEUE_CONNECTION=rabbitmq
      - RABBITMQ_HOST=rabbitmq
      - RABBITMQ_PORT=5672
      - DB_HOST=postgres
      - DB_DATABASE=payment_gym
      - DB_USERNAME=payment_user
      - DB_PASSWORD=secret
    volumes:
      - .:/var/www/html
    depends_on:
      - app
      - postgres
      - rabbitmq
    networks:
      - laravel-network

  prometheus:
    image: prom/prometheus:latest
    container_name: laravel12-prometheus
    ports:
      - "9090:9090"
    volumes:
      - ./prometheus.yml:/etc/prometheus/prometheus.yml:ro
    command:
      - '--config.file=/etc/prometheus/prometheus.yml'
      - '--web.enable-lifecycle'
    networks:
      - laravel-network

  grafana:
    image: grafana/grafana:latest
    container_name: laravel12-grafana
    ports:
      - "3000:3000"
    environment:
      - GF_SECURITY_ADMIN_USER=admin
      - GF_SECURITY_ADMIN_PASSWORD=admin
    volumes:
      - grafana-storage:/var/lib/grafana
    depends_on:
      - prometheus
    networks:
      - laravel-network

  elasticsearch:
    image: docker.elastic.co/elasticsearch/elasticsearch:8.15.0
    container_name: laravel12-elasticsearch
    environment:
      - discovery.type=single-node
      - xpack.security.enabled=false
      - "ES_JAVA_OPTS=-Xms512m -Xmx512m"
    ports:
      - "9200:9200"
      - "9300:9300"
    volumes:
      - elasticsearch-data:/usr/share/elasticsearch/data
    networks:
      - laravel-network

  clickhouse:
    image: clickhouse/clickhouse-server:latest
    container_name: laravel12-clickhouse
    ports:
      - "8123:8123"
      - "9000:9000"
    environment:
      - CLICKHOUSE_DEFAULT_ACCESS_MANAGEMENT=0
    volumes:
      - clickhouse-data:/var/lib/clickhouse
    networks:
      - laravel-network

volumes:
  pgdata:
  rabbitmq_data:
  grafana-storage:
  elasticsearch-data:
  clickhouse-data:

networks:
  laravel-network:
    driver: bridge

  clickhouse:
    image: clickhouse/clickhouse-server:latest
    container_name: laravel12-clickhouse
    ports:
      - "8123:8123"
      - "9000:9000"
    volumes:
      - clickhouse-data:/var/lib/clickhouse
      - ./clickhouse-config.xml:/etc/clickhouse-server/users.d/no-password.xml
    networks:
      - laravel-network
